{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "/api/leads?resource=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/leads?resource=oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/leads?resource=oauth-protected-resource"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/callhippo-sync",
      "schedule": "0 2 * * *"
    }
  ]
}
